    //#region OTP timer
    timer(minute) {
        // let minute = 1;
        let seconds = minute * 60;
        let textSec = '0';
        let statSec = 60;
        const prefix = minute < 10 ? '0' : '';
        const timer = setInterval(() => {
            seconds--;
            if (statSec != 0)
                statSec--;
            else
                statSec = 59;
            if (statSec < 10) {
                textSec = '0' + statSec;
            }
            else
                textSec = statSec;
            this.display = `${prefix}${Math.floor(seconds / 60)}:${textSec}`;
            if (seconds == 0) {
                clearInterval(timer);
            }
        }, 1000);
    }
