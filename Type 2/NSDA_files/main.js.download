                        this.myInputVariable.nativeElement.value = '';
                        return;
                    }
                }
                if (existItem.length > 1) {
                    this.notification.error('Failed', 'Duplicate PPE name found in Excel, Please check!');
                    this.myInputVariable.nativeElement.value = '';
                    return;
                }
            }
        }
        //#region Excel duplication value check
        // let existItem = this.excelData.filter(
        //   (item) => item.PpeName == stpTrainer.PpeName
        // );
        // if (existItem.length > 1) {
        //   this.notification.error(
        //     'Failed',
        //     'Duplicate Data found in Excel, Please check!'
        //   );
        //   return;
        // }
        //#endregion Excel duplication value check
        // if(this.cadStorageService.isStpMainAlreadyCreated){
        this.cadStorageService
            .saveExcelCadPpeData(cadPpeList)
            .subscribe({
            next: (response) => {
                this.notification.success('Success!', 'Cad PPE created successfully');
            },
            error: (error) => this.notification.error('Failed', 'Please! provide valid information'),
        });
        // }
        // else {
        //   this.notification.error(
        //     'Failed',
        //     'Please fill up basic profile first.'
        //   );
        // }
        this.myInputVariable.nativeElement.value = '';
        return;
    }
}
