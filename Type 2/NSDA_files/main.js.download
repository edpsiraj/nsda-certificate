class TamPreviewSubmitComponent {
    constructor(trainingAndAssessmentMaterialsStorageService, notification, route, commonStorageService, sanitizer, router) {
        // Extract tamMainId from query parameters
        this.trainingAndAssessmentMaterialsStorageService = trainingAndAssessmentMaterialsStorageService;
        this.notification = notification;
        this.route = route;
        this.commonStorageService = commonStorageService;
        this.sanitizer = sanitizer;
        this.router = router;
        this.csList = [];
        this.occupationList = [];
        this.occupationMap = new Map();
        this.csShow = false;
        this.cadShow = false;
        // Arrays for competency data
        this.genericCompetencies = [];
        this.specificCompetencies = [];
        this.occupationCompetencies = [];
        // Pagination variables for generic table (adjust as needed for others)
        this.total = 0;
        this.size = 10;
        this.page = 1;
        this.showingAction = false;
        this.showCreateButton = false;
        this.imageURL = null;
        this.pdfUrl = null;
        this.isVisibleForAttachment = false;
        this.isImageLoading = true;
        this.imageTypeArray = ['jpg', 'jpeg', 'png'];
        this.trainingAndAssessmentMaterialsStorageService
            .readTamMainById(this.tamMainId)
            .subscribe((res) => {
            this.tamMain = res.data;
            // Convert date arrays into Date objects if necessary.
            if (this.tamMain.approvalDate &&
                Array.isArray(this.tamMain.approvalDate)) {
                // Note: Month in JavaScript is 0-based.
                const [year, month, day, hour, minute] = this.tamMain.approvalDate;
                this.tamMain.approvalDate = new Date(year, month - 1, day, hour, minute);
            }
            if (this.tamMain.receivedDate &&
                Array.isArray(this.tamMain.receivedDate)) {
                const [year, month, day, hour, minute] = this.tamMain.receivedDate;
                this.tamMain.receivedDate = new Date(year, month - 1, day, hour, minute);
            }
            this.additionalInformation(this.tamMain);
        });
    }
    ngOnInit() {
        this.tamMainId = Number(this.route.snapshot.queryParamMap.get('tamMainId'));
        this.varTamTypeSelectedId = Number(this.route.snapshot.queryParamMap.get('tamTypeId'));
        if ((this.tamMainId === null && this.tamMainId === '') || (this.varTamTypeSelectedId === null && this.varTamTypeSelectedId === '')) {
            this.router.navigate(['home/training-and-assessment-materials/tam-list']);
        }
        this.trainingAndAssessmentMaterialsStorageService
            .getTamMainStatusById(this.tamMainId)
            .subscribe({
            next: (response) => {
                //alert(JSON.stringify(response));
                if (response.success) {
                    this.notification.error('Error', 'Final Submission done');
                    this.router.navigate(['home/training-and-assessment-materials/tam-list']);
                }
                else {
                    if (this.tamMainId > 0) {
                        this.trainingAndAssessmentMaterialsStorageService
                            .readTamMainById(this.tamMainId)
                            .subscribe((res) => {
                            this.tamMain = res.data;
                            this.varTamTypeSelectedId = this.tamMain.tamType.id;
                            //alert("anirban"+ this.tamMain.tamType.id);
                            /*if (res.status === undefined || res.status === null){
                              this.showCreateButton= true;
                            }else{
                              this.showCreateButton = false;
          
                            }*/
                            // Convert date arrays into Date objects if necessary.
                            if (this.tamMain.approvalDate &&
                                Array.isArray(this.tamMain.approvalDate)) {
                                // Note: Month in JavaScript is 0-based.
                                const [year, month, day, hour, minute] = this.tamMain.approvalDate;
                                this.tamMain.approvalDate = new Date(year, month - 1, day, hour, minute);
                            }
                            if (this.tamMain.receivedDate &&
                                Array.isArray(this.tamMain.receivedDate)) {
                                const [year, month, day, hour, minute] = this.tamMain.receivedDate;
                                this.tamMain.receivedDate = new Date(year, month - 1, day, hour, minute);
                            }
                            this.additionalInformation(this.tamMain);
                        });
                    }
                }
            },
            error: (error) => {
                this.notification.error('Error', 'Final Submission done');
                this.router.navigate(['home/training-and-assessment-materials/tam-list']);
            }
        });
        this.userId();
        this.getOccupationList();
    }
    getOccupationList() {
        this.trainingAndAssessmentMaterialsStorageService
            .getOccupationList()
            .subscribe({
            next: (res) => {
                const list = Array.isArray(res) ? res : res.data;
                if (!list) {
                    console.error('Occupation list is empty or invalid:', res);
                    return;
                }
                this.occupationList = list;
                this.occupationMap = new Map(this.occupationList.map((o) => [String(o.id), o.name]));
                this.loadTamData();
            },
            error: () => {
                this.notification.error('Error', 'Failed to load occupation list');
            },
        });
    }
    userId() {
        this.userInfo = JSON.parse(localStorage.getItem('currentUserInfo') || '{}');
    }
