        }, (errorMessage) => {
            this.notification.error('Failed', errorMessage);
        });
        for (const i in this.loginForm.controls) {
            this.loginForm.controls[i].markAsDirty();
            this.loginForm.controls[i].updateValueAndValidity();
        }
    }
    resetLoginForm() {
        this.loginForm.reset();
    }
}
