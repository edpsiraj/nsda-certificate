        this.createCustomButtonModal();
    }
    createCustomButtonModal(data) {
        this.cadStorageService
            .checkExistingCourseAccreditationByTamMainId(this.tamMainId)
            .subscribe({
            next: (response) => {
                if (response.success == true) {
                    // this.modalRef = this.modal.create({
                    //   nzContent: AddCadLearningMaterialComponent,
                    //   nzClosable: false,
                    //   nzOkText: null,
                    //   nzWidth: 1000,
                    //   nzComponentParams: {
                    //     InputData: data,
                    //   },
                    // });
                    this.checkApplication = true;
                }
                else {
                    this.checkApplication = false;
                    // this.notification.error('Failed!', response.message);
                }
            },
            error: (error) => this.notification.error('Failed!', error),
        });
    }
