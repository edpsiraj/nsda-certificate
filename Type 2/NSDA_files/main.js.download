        if (!this.loginForm.valid) {
            this.notification.error('Form Validation Failed!', 'Please Provide your email and password');
            return;
        }
        const credentials = {
            usernameOrEmail: this.loginForm.controls.userName.value,
            password: this.loginForm.controls.password.value,
        };
        this.authenticationStorageService.NAPLogin(credentials).subscribe((response) => {
            const returnUrl = this.route.snapshot.queryParams.returnUrl || '/NAP-home';
