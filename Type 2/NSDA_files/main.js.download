        // console.log(params);
        this.page = params.pageIndex;
        this.size = params.pageSize;
        const { pageSize, pageIndex, sort } = params;
        this.getCadList();
    }
    onEdit(id) {
        this.cadService.setEditingCadOtherRequirementId(id);
