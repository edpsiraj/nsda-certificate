            .checkExistingCourseAccreditationByTamMainId(this.tamMainId)
            .subscribe({
            next: (response) => {
                if (response.success == true) {
                    // this.modalRef = this.modal.create({
                    //   nzContent: AddCadTrainerAndStaffComponent,
                    //   nzClosable: false,
