class ViewFreelancerCertificateComponent {
    constructor(tciInfoStorageService, route) {
        this.tciInfoStorageService = tciInfoStorageService;
        this.route = route;
        this.tciId = this.route.snapshot.queryParamMap.get('id');
    }
    ngOnInit() {
        if (this.tciId != null) {
            this.getCertificateData();
        }
    }
    getCertificateData() {
        this.tciInfoStorageService
            .getFreelancerCertificateByEncryptedId(this.tciId)
            .subscribe({
            next: (result) => {
                this.tciInfo = result.tciInfoPayload;
                let issueDateStr = this.tciInfo.issueDate.toString();
                issueDateStr = issueDateStr.split('T')[0];
                let issueDate = this.convertStringToDate(issueDateStr);
                const firstCutoff = this.convertStringToDate('2024-08-08');
                const secondCutoff = this.convertStringToDate('2026-02-18');
                this.officeText =
                    issueDate <= firstCutoff || issueDate >= secondCutoff
                        ? 'Prime Minister’s Office'
                        : 'Chief Adviser’s Office';
                //#endregion
            },
        });
    }
    convertStringToDate(dateStr) {
        const [day, month, year] = dateStr.split('-').map(Number);
        return new Date(day, month - 1, year);
