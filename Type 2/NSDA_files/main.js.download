        this.nameAlreadyExist = false;
        setTimeout(() => {
            if (name.value.length > 3) {
                this.authStorageService.checkApplicantEmailExist(name.value).subscribe({
                    next: (res) => {
                        if (res.data == null) {
                            this.nameAlreadyExist = false;
                        }
                        else {
                            this.nameAlreadyExist = true;
                            this.assessorRegForm.controls.name.setErrors({
                                incorrect: true,
                            });
                        }
                    },
                });
            }
        }, 2000);
    }
    validateConfirmPassword() {
        setTimeout(() => this.assessorRegForm.controls.confirmPassword.updateValueAndValidity());
    }
    nidValidation(control) {
        if (control.value.length <= 10) {
            return { error: true, required: true };
        }
        else if (control.value.length <= 17) {
            return { error: true, required: true };
        }
        return {};
    }
