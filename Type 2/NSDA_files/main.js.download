        this.modalRef = this.modal.create({
            nzContent: _add_cad_learning_material_add_cad_learning_material_component__WEBPACK_IMPORTED_MODULE_0__["AddCadLearningMaterialComponent"],
            nzClosable: false,
            nzOkText: null,
            nzWidth: 1000,
            nzComponentParams: {
                InputData: data
            }
        });
    }
    ngOnDestroy() {
        this.onCadLearningMaterialSubscription$.unsubscribe();
    }
    onQueryParamsChange(params) {
        // console.log(params);
        this.page = params.pageIndex;
        this.size = params.pageSize;
        const { pageSize, pageIndex, sort } = params;
        this.getCadList();
    }
    onEdit(id) {
        this.cadService.setEditingCadLearningMaterialId(id);
        this.createCustomButtonModalForEdit(id);
    }
    createCustomButtonModalForEdit(data) {
        this.modalRef = this.modal.create({
            nzContent: _add_cad_learning_material_add_cad_learning_material_component__WEBPACK_IMPORTED_MODULE_0__["AddCadLearningMaterialComponent"],
            nzClosable: false,
            nzOkText: null,
            nzWidth: 1000,
            nzComponentParams: {
                InputData: data,
            },
        });
    }
    onDelete(id) {
        this.cadStorageService.deleteCadLearningMaterial(id).subscribe({
            next: (response) => {
                this.notification.success('Success!', 'Staff deleted successfully');
                this.getCadList();
            },
            error: (error) => {
                if (error.error.message !== undefined && error.error.message !== null) {
                    this.notification.error('Failed', error.error.message);
                }
                else {
                    this.notification.error('Failed', "Error");
                }
            },
        });
    }
}
