            const isValid = !isNaN(expireDate.getTime());
            if (isValid) {
                const today = new Date();
                expireDate.setHours(0, 0, 0, 0);
                today.setHours(0, 0, 0, 0);
                const diffTime = expireDate.getTime() - today.getTime();
