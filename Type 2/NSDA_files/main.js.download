    //     }
    //   }, 2000);
    // }
    onNidInput(nid) {
        const digitsOnly = nid.value.replace(/\D/g, '');
        if (digitsOnly !== nid.value) {
            this.assessorRegForm.controls.nid.setValue(digitsOnly);
        }
    }
    checkNidExist(nid) {
        this.nidAlreadyExist = false;
        const nidControl = this.assessorRegForm.controls.nid;
        if (!(nid === null || nid === void 0 ? void 0 : nid.value) ||
            nidControl.hasError('required') ||
            nidControl.hasError('pattern')) {
            return;
        }
        this.authStorageService.checkAssessorNidExist(nid.value).subscribe({
            next: (res) => {
                if (res.data === true) {
                    this.nidAlreadyExist = true;
                    this.assessorRegForm.controls.nid.setErrors({
                        nidExists: true,
                    });
                }
                else {
                    this.nidAlreadyExist = false;
                    nidControl.updateValueAndValidity();
                }
            },
            error: () => {
                this.nidAlreadyExist = false;
            },
        });
    }
    startCountdown(durationInSeconds) {
        this.countdown = durationInSeconds;
        this.timerInterval = setInterval(() => {
            const minutes = Math.floor(this.countdown / 60);
            const seconds = this.countdown % 60;
            this.timerText = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            if (this.countdown <= 0) {
                this.resetCountdown();
                //this.isVisible=false;
            }
            else {
                this.countdown--;
            }
            if (this.countdown === 0) {
                //alert("Reset OTP function call")
                this.showResendOTP = true;
                this.alreadySmsSend = false;
                //this.timerSub.unsubscribe();
            }
        }, 1000);
    }
    resetCountdown() {
        clearInterval(this.timerInterval);
        this.timerText = '5:00'; // Reset UI
    }
    ngOnDestroy() {
        clearInterval(this.timerInterval);
    }
    resendOTP() {
        this.otpIsLoading = true;
        if (!this.assessorRegForm.valid) {
            Object.keys(this.assessorRegForm.controls).forEach((key) => {
                this.assessorRegForm.controls[key].markAsDirty();
                this.assessorRegForm.controls[key].updateValueAndValidity();
            });
            this.otpIsLoading = false;
            return;
        }
        const mobileControl = this.assessorRegForm.controls['contactNumber'];
        this.authStorageService.getOtp('0' + mobileControl.value).subscribe({
            next: () => {
                console.log('OTP sent successfully');
                this.notification.success('OTP Sent', 'An OTP has been sent to your phone number.');
                this.submitOtpToMobile = true;
                this.startCountdown(this.timelimit);
                this.showModal();
                this.otpIsLoading = false;
                this.alreadySmsSend = true;
            },
            error: () => {
                this.notification.error('Failed', 'Failed to send OTP, please try again.');
                this.otpIsLoading = false;
            },
        });
    }
}
