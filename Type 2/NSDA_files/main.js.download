                queryParams: { tamMainId: this.tamMainId }
            });
        }
    } // end function
    finalSubmit(tamMainId) {
        let type = '';
        this.varTamTypeSelectedId = Number(this.route.snapshot.queryParamMap.get('tamTypeId'));
        if ((this.tamMainId === null && this.tamMainId === '') || (this.varTamTypeSelectedId === null && this.varTamTypeSelectedId === '')) {
            this.notification.error("Error", "Operation Failed");
        }
        else {
            if (this.varTamTypeSelectedId === 1) {
                type = 'cs';
            }
            else if (this.varTamTypeSelectedId === 2) {
                type = 'cad';
            }
        }
        if (this.varTamTypeSelectedId === 1 || this.varTamTypeSelectedId === 2) {
            this.trainingAndAssessmentMaterialsStorageService
                .checkCsCadCountStatus(type, tamMainId)
                .subscribe({
                next: (response) => {
                    if (response.success) {
                        this.trainingAndAssessmentMaterialsStorageService
                            .statusUpdateByTamMainId(this.tamMainId)
                            .subscribe({
                            next: (response) => {
                                if (response.success) {
                                    this.notification.success('Success!', 'TAM Submitted Successfully');
                                    this.router.navigate(['home/training-and-assessment-materials/tam-list']);
                                }
                                else {
                                    this.notification.error('Failed!', response.message);
                                }
                            },
                            error: (error) => {
                                this.notification.error('Failed!', error.message);
                            },
                        });
                    }
                    else {
                        this.notification.error("Warning!", "At least one additional information must be added");
                        return;
                    }
                },
                error: (error) => {
                    this.notification.error("Error", "Operation Failed");
                },
            });
        }
        else {
            this.trainingAndAssessmentMaterialsStorageService
                .statusUpdateByTamMainId(this.tamMainId)
                .subscribe({
                next: (response) => {
                    if (response.success) {
                        this.notification.success('Success!', 'TAM Submitted Successfully');
                        this.router.navigate(['home/training-and-assessment-materials/tam-list']);
                    }
                    else {
                        this.notification.error('Failed!', response.message);
                    }
                },
                error: (error) => {
                    this.notification.error('Failed!', error.message);
                },
            });
        }
    } //end function
