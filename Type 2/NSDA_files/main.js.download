class ViewRegularCertificateComponent {
    constructor(route, commonService) {
        this.route = route;
        this.commonService = commonService;
        this.competent = false;
        this.isLoadingData = false;
        this.regCandidateId =
            this.route.snapshot.queryParamMap.get('regCandidateId');
        if (this.regCandidateId != null) {
            this.getCertificateDataForRegularCandidate();
        }
    }
    ngOnInit() { }
    getCertificateDataForRegularCandidate() {
        this.commonService
            .getRegularCertificateByEncryptedId(this.regCandidateId)
            .subscribe({
            next: (result) => Object(tslib__WEBPACK_IMPORTED_MODULE_0__["__awaiter"])(this, void 0, void 0, function* () {
                this.certificateData = yield result;
                this.competent = this.certificateData.isCompetent;
                //#region change office name logic
                let actualAssessDate = this.convertStringToDate(this.certificateData.actualAssessDate);
                const firstCutoff = this.convertStringToDate('08-08-2024');
                const secondCutoff = this.convertStringToDate('18-02-2026');
                // Normalize time to avoid timezone/time comparison issues
                actualAssessDate.setHours(0, 0, 0, 0);
                firstCutoff.setHours(0, 0, 0, 0);
                secondCutoff.setHours(0, 0, 0, 0);
                // Logic:
                // Before 08-08-2024 → Prime Minister’s Office
                // 09-08-2024 to 17-02-2026 → Chief Adviser’s Office
                // From 18-02-2026 onward → Prime Minister’s Office
                this.officeText =
                    actualAssessDate <= firstCutoff || actualAssessDate >= secondCutoff
                        ? 'Prime Minister’s Office'
                        : 'Chief Adviser’s Office';
                //#endregion
                this.isLoadingData = true;
            }),
            error: (err) => {
                console.error('Error fetching certificate data:', err);
                this.isLoadingData = false;
            },
        });
    }
    convertStringToDate(dateStr) {
        const [day, month, year] = dateStr.split('-').map(Number);
        return new Date(year, month - 1, day);
    }
}
