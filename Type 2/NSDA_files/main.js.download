    //#endregion OTP
    refreshCaptcha() {
        this.captchaText = this.captchaService.captchaGenerator();
        this.captchaError = false;
    }
    verify() {
        if (this.userInput === this.captchaText) {
            this.submitForm();
        }
        else {
            this.notification.error('Invalid!', 'Please correct the CAPTCHA!');
            this.captchaError = true;
        }
    }
    checkNidExist(nid) {
        this.nidAlredyExist = false;
        setTimeout(() => {
            if (nid.value.length > 9) {
                this.authStorageService.checkApplicantNidExist(nid.value).subscribe({
                    next: (res) => {
                        if (res.data == null) {
                            this.nidAlredyExist = false;
                        }
                        else {
                            this.nidAlredyExist = true;
                            this.applicantProfileRegistrationForm.controls.nid.setErrors({
                                incorrect: true,
                            });
                        }
                    },
                });
            }
        }, 2000);
    }
    /****** new OTP ******/
    showModal() {
        this.isVisible = true;
    }
    handleCancel() {
        this.isVisible = false;
        this.resetCountdown();
    }
    startCountdown(durationInSeconds) {
        this.countdown = durationInSeconds;
        this.timerInterval = setInterval(() => {
            const minutes = Math.floor(this.countdown / 60);
            const seconds = this.countdown % 60;
            this.timerText = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            if (this.countdown <= 0) {
                this.resetCountdown();
                //this.isVisible=false;
                this.isVisible = true;
            }
            else {
                this.countdown--;
            }
            if (this.countdown === 0) {
                this.showResendOTP = true;
                this.alreadySmsSend = false;
            }
        }, 1000);
    }
    resetCountdown() {
        clearInterval(this.timerInterval);
        this.timerText = '5:00'; // Reset UI
    }
    ngOnDestroy() {
        clearInterval(this.timerInterval);
    }
    resendOTP() {
        this.otpIsLoading = true;
        if (!this.applicantProfileRegistrationForm.valid) {
            Object.keys(this.applicantProfileRegistrationForm.controls).forEach((key) => {
                this.applicantProfileRegistrationForm.controls[key].markAsDirty();
                this.applicantProfileRegistrationForm.controls[key].updateValueAndValidity();
            });
            this.otpIsLoading = false;
            return;
        }
        const mobileControl = this.applicantProfileRegistrationForm.controls['contactNumber'];
        this.authStorageService.getOtp('0' + mobileControl.value).subscribe({
            next: () => {
                console.log('OTP sent successfully');
                this.notification.success('OTP Sent', 'An OTP has been sent to your phone number.');
                this.submitOtpToMobile = true;
                this.startCountdown(this.timelimit);
                this.showModal();
                this.otpIsLoading = false;
                this.alreadySmsSend = true;
            },
            error: () => {
                this.notification.error('Failed', 'Failed to send OTP, please try again.');
                this.otpIsLoading = false;
            },
        });
    }
}
