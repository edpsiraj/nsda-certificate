class PreviousStpApplicationComponent {
    constructor(stpRegistrationStorageService, fb) {
        this.stpRegistrationStorageService = stpRegistrationStorageService;
        this.fb = fb;
        this.stpApplicationDto = [];
        this.page = 1;
        this.size = 10;
        this.total = 0;
        this.sortBy = 'id';
        this.sortDir = 'desc';
        this.loading = false;
        this.searchingForm = this.fb.group({
            stpApplicationId: [null],
            stpIsApproved: [null],
            stpIsNotApproved: [null],
            currectionNeeded: [null],
            stpName: [null],
            stpOwnerShipStatusId: [null],
            sysDistrictId: [null],
            occupationName: [null],
            submissionStatusId: [null],
            pendingStp: [null],
            registrationNo: [null],
        });
    }
    ngOnInit() {
        this.getPreviousStpApplicationList();
    }
    getPreviousStpApplicationList() {
        this.loading = true;
        this.stpRegistrationStorageService.getPreviousStpApplication(this.page, this.size, this.searchingForm.value, this.sortBy, this.sortDir).subscribe({
            next: (res) => {
                this.stpList = res.data.content;
                this.total = res.data.totalElements;
                this.loading = false;
            },
            error: () => {
                this.loading = false;
            }
        });
    }
    onQueryParamsChange(params) {
        const { pageSize, pageIndex, sort } = params;
        this.size = pageSize;
        this.page = pageIndex;
        const currentSort = sort.find(s => s.value !== null);
        if (currentSort) {
            this.sortBy = currentSort.key;
            this.sortDir = currentSort.value === 'ascend' ? 'asc' : 'desc';
        }
        this.getPreviousStpApplicationList(); // ✅ fetch new page from backend
    }
    onSearch() {
        this.page = 1;
    }
    onRefresh() {
        this.getPreviousStpApplicationList();
    }
}
