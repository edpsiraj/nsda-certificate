class CadTrainerAndStaffTableComponent {
    constructor(modal, cadService, cadStorageService, notification, route) {
        this.modal = modal;
        this.cadService = cadService;
        this.cadStorageService = cadStorageService;
        this.notification = notification;
        this.route = route;
        this.cadList = [];
        this.cadListFiltered = [];
        this.page = 1;
        this.size = 10;
        this.checkApplication = true;
        this.tamMainId = Number(this.route.snapshot.queryParamMap.get('tamMainId'));
        const urlPath = String(this.route.snapshot.url[0].path);
        urlPath.includes('tam-view')
            ? (this.showingAction = true)
            : (this.showingAction = false);
        this.cadList = this.cadService.getCadTrainerAndStaffList(this.tamMainId);
        this.cadListFiltered = [...this.cadList];
        if (this.cadList.length === 0) {
            this.cadStorageService
                .readCadTrainerAndStaffListByTamId(this.tamMainId, this.page, this.size)
                .subscribe();
        }
        this.onCadTrainerAndStaffSubscription$ =
            this.cadService.onRefreshCadTrainerAndStaffList.subscribe((res) => {
                this.cadList = res;
                this.cadListFiltered = [...this.cadList];
            });
    }
    ngOnInit() {
        this.getCadList();
    }
