class CblmGenericDataComponent {
    constructor(trainingAndAssessmentMaterialsStorageService, notification, route, commonStorageService, sanitizer, router) {
        this.trainingAndAssessmentMaterialsStorageService = trainingAndAssessmentMaterialsStorageService;
        this.notification = notification;
        this.route = route;
        this.commonStorageService = commonStorageService;
        this.sanitizer = sanitizer;
        this.router = router;
        this.csList = [];
        this.occupationList = [];
        this.occupationMap = new Map();
        this.csShow = false;
        this.cadShow = false;
        this.showCreateButton = false;
        // Arrays for competency data
        this.genericCompetencies = [];
        this.specificCompetencies = [];
        this.occupationCompetencies = [];
        this.cblmListGeneric = [];
        this.cblmListSector = [];
        // Pagination variables for generic table (adjust as needed for others)
        this.total = 0;
        this.size = 10;
        this.page = 1;
        this.showingAction = false;
        this.imageURL = null;
        this.pdfUrl = null;
        this.isVisibleForAttachment = false;
        this.isImageLoading = true;
        this.imageTypeArray = ['jpg', 'jpeg', 'png'];
        // Extract tamMainId from query parameters
        this.tamMainId = Number(this.route.snapshot.queryParamMap.get('tamMainId'));
        this.trainingAndAssessmentMaterialsStorageService
            .readTamMainById(this.tamMainId)
            .subscribe((res) => {
            this.tamMain = res.data;
            this.varTamTypeSelectedId = this.tamMain.tamType.id;
            // Convert date arrays into Date objects if necessary.
            if (this.tamMain.approvalDate &&
                Array.isArray(this.tamMain.approvalDate)) {
                // Note: Month in JavaScript is 0-based.
                const [year, month, day, hour, minute] = this.tamMain.approvalDate;
                this.tamMain.approvalDate = new Date(year, month - 1, day, hour, minute);
            }
            if (this.tamMain.receivedDate &&
                Array.isArray(this.tamMain.receivedDate)) {
                const [year, month, day, hour, minute] = this.tamMain.receivedDate;
                this.tamMain.receivedDate = new Date(year, month - 1, day, hour, minute);
            }
            this.additionalInformation(this.tamMain);
        });
    }
    ngOnInit() {
        this.tamMainId = Number(this.route.snapshot.queryParamMap.get('tamMainId'));
        if ((this.tamMainId === null && this.tamMainId === '')) {
            this.router.navigate(['home/training-and-assessment-materials/tam-list']);
        }
        this.trainingAndAssessmentMaterialsStorageService
            .readTamMainById(this.tamMainId)
            .subscribe((res) => {
            this.tamMain = res.data;
            this.varTamTypeSelectedId = this.tamMain.tamType.id;
            if (this.varTamTypeSelectedId === 4) {
                this.trainingAndAssessmentMaterialsStorageService
                    .readCblmDataByTamMainId(this.tamMainId)
                    .subscribe({
                    next: (res) => {
                        this.cblmListGeneric = res.data.tamGeneric;
                        //alert(JSON.stringify(this.cblmListGeneric));
                        this.cblmListSector = res.data.tamSector;
                        if (res.data.tamSector == null) {
                            this.countSector = 0;
                        }
                        else {
                            this.countSector = this.cblmListSector.length;
                        }
                        if (res.data.tamSector == null) {
                            this.countGeneric = 0;
                        }
                        else {
                            this.countGeneric = this.cblmListGeneric.length;
                        }
                        //alert(JSON.stringify(this.cblmListSector));                     
                    },
                    error: () => {
                        //this.notification.error('Error', 'Failed to load CBLM data');
                    },
                });
            } // end if 
            // Convert date arrays into Date objects if necessary.
            if (this.tamMain.approvalDate &&
                Array.isArray(this.tamMain.approvalDate)) {
                // Note: Month in JavaScript is 0-based.
                const [year, month, day, hour, minute] = this.tamMain.approvalDate;
                this.tamMain.approvalDate = new Date(year, month - 1, day, hour, minute);
            }
            if (this.tamMain.receivedDate &&
                Array.isArray(this.tamMain.receivedDate)) {
                const [year, month, day, hour, minute] = this.tamMain.receivedDate;
                this.tamMain.receivedDate = new Date(year, month - 1, day, hour, minute);
            }
            this.additionalInformation(this.tamMain);
        });
        this.userId();
        this.getOccupationList();
    }
    getOccupationList() {
        this.trainingAndAssessmentMaterialsStorageService
            .getOccupationList()
            .subscribe({
            next: (res) => {
                const list = Array.isArray(res) ? res : res.data;
                if (!list) {
                    console.error('Occupation list is empty or invalid:', res);
                    return;
                }
                this.occupationList = list;
                this.occupationMap = new Map(this.occupationList.map((o) => [String(o.id), o.name]));
                this.loadTamData();
            },
            error: () => {
                this.notification.error('Error', 'Failed to load occupation list');
            },
        });
    }
    userId() {
        this.userInfo = JSON.parse(localStorage.getItem('currentUserInfo') || '{}');
    }
    loadTamData() {
        this.trainingAndAssessmentMaterialsStorageService
            .getTamDetailWithCBLM(this.tamMainId)
            .subscribe({
            next: (res) => {
                // Assuming the API returns keys: genericCompetencies, specificCompetencies, occupationCompetencies
                this.genericCompetencies = res.genericCompetencies || [];
                this.specificCompetencies = res.specificCompetencies || [];
                this.occupationCompetencies = res.occupationCompetencies.map((item) => {
                    var _a;
                    return (Object.assign(Object.assign({}, item), { occupationName: (_a = this.occupationMap.get(String(item.occupation))) !== null && _a !== void 0 ? _a : item.occupation }));
                });
                // For pagination example (generic competency table)
                this.total = this.genericCompetencies.length;
            },
            error: () => {
                this.notification.error('Error', 'Failed to load competency data');
            },
        });
    }
    additionalInformation(tamMain) {
        if (tamMain.tamType && tamMain.tamType.shortName.toUpperCase() === 'CS') {
            this.csShow = true;
        }
        else if (tamMain.tamType &&
            tamMain.tamType.shortName.toUpperCase() === 'CAD') {
            this.cadShow = true;
        }
    }
    onDownload(data) {
        this.commonStorageService.downloadFile(data.docFilePath).subscribe({
            next: (result) => {
                let fileName = data.tamApplicationId;
                const contentDisposition = result.headers.get('Content-Disposition');
                if (contentDisposition) {
                    const fileNameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                    const matches = fileNameRegex.exec(contentDisposition);
                    if (matches != null && matches[1]) {
                        const totalFileName = matches[1].replace(/['"]/g, '');
                        const fullFile = totalFileName.split('.');
                        const exten = fullFile[1];
                        fileName = fileName + '.' + exten;
