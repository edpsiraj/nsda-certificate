        // this.onCadToolSubscription$ = this.cadService.onRefreshCadToolList.subscribe(
        //   (res) => {
        //     this.cadList = res.filter(
        //       (item) =>
        //         item.tamMainId == this.tamMainId ||
        //         item.tamMain.id == this.tamMainId
        //     );
        //     if(this.modalRef) {
        //       this.modalRef.close();
        //     }
        //   }
        // );
        this.createCustomButtonModal();
    }
    createCustomButtonModal(data) {
        this.cadStorageService
            .checkExistingCourseAccreditationByTamMainId(this.tamMainId)
            .subscribe({
            next: (response) => {
                if (response.success == true) {
                    // this.modalRef = this.modal.create({
                    //   nzContent: AddCadToolComponent,
                    //   nzClosable: false,
                    //   nzOkText: null,
                    //   nzWidth: 1000,
                    //   nzComponentParams: {
                    //     InputData: data,
                    //   },
                    // });
                    this.checkApplication = true;
                }
                else {
                    this.checkApplication = false;
                    // this.notification.error('Failed!', response.message);
                }
            },
            error: (error) => this.notification.error('Failed!', error),
        });
    }
    showModal(data) {
        this.modalRef = this.modal.create({
            nzContent: _add_cad_tool_add_cad_tool_component__WEBPACK_IMPORTED_MODULE_0__["AddCadToolComponent"],
            nzClosable: false,
            nzOkText: null,
            nzWidth: 1000,
            nzComponentParams: {
                InputData: data
            }
        });
    }
    ngOnDestroy() {
        this.onCadToolSubscription$.unsubscribe();
    }
    onQueryParamsChange(params) {
        // console.log(params);
        this.page = params.pageIndex;
        this.size = params.pageSize;
        const { pageSize, pageIndex, sort } = params;
        this.getCadList();
    }
    onEdit(id) {
        this.cadService.setEditingCadToolId(id);
        this.createCustomButtonModalforEdit(id);
    }
    createCustomButtonModalforEdit(data) {
        this.modalRef = this.modal.create({
            nzContent: _add_cad_tool_add_cad_tool_component__WEBPACK_IMPORTED_MODULE_0__["AddCadToolComponent"],
            nzClosable: false,
            nzOkText: null,
            nzWidth: 1000,
            nzComponentParams: {
                InputData: data,
            },
        });
    }
    onDelete(id) {
        this.cadStorageService.deleteCadTool(id).subscribe({
            next: (response) => {
                this.notification.success('Success!', 'Staff deleted successfully');
                this.getCadList();
            },
            error: (error) => {
                if (error.error.message !== undefined && error.error.message !== null) {
                    this.notification.error('Failed', error.error.message);
                }
                else {
                    this.notification.error('Failed', 'Please! provide valid information');
                }
            },
        });
    }
}
