class RequiredPermissionDirective {
    constructor(el, authorizationService) {
        this.el = el;
        this.authorizationService = authorizationService;
        this.permission = ''; // Required permission passed in
    }
    ngOnInit() {
        if (this.permission.includes(',')) {
            let tempList = this.permission.split(',');
            if (this.authorizationService.checkIfCurrentUserHaveAnyPermission(tempList) == false) {
                this.el.nativeElement.style.display = 'none';
            }
            ;
        }
        else if (!this.authorizationService.checkIfCurrentUserHavePermission(this.permission)) {
            this.el.nativeElement.style.display = 'none';
        }
    }
}
