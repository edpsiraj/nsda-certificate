            .subscribe({
            next: (response) => {
                this.notification.success('Success!', 'Cad Trainer And Staff created successfully');
            },
            error: (error) => this.notification.error('Failed', 'Please! provide valid information'),
        });
        this.myInputVariable.nativeElement.value = '';
        return;
    }
