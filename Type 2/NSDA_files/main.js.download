    getUnreadNotificationCount() {
        this.commonService.getUnreadNotificationCount(this.userInfoId).subscribe({
            next: (res) => {
                if (res) {
                    this.notificationData = res;
                }
            },
            error: (err) => console.error('Failed to load unread counts', err)
        });
